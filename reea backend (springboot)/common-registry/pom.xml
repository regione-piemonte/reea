<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>it.csi.registry</groupId>
		<artifactId>amianto-registry-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>common-registry</artifactId>
	<packaging>jar</packaging>

	<properties>
		<java.version>17</java.version>
		<openapi.generator.version>7.6.0</openapi.generator.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<dependencies>
		<!-- Spring Web (serve solo per le annotazioni generate) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Jakarta Validation -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
			<version>3.0.2</version>
		</dependency>

		<!-- Jakarta Annotations -->
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- Servlet API (solo compile, non finisce nel jar finale) -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>6.0.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- Swagger annotations -->
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations</artifactId>
			<version>2.2.22</version>
		</dependency>

		<!-- Jackson nullable (richiesto da openapi-generator) -->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>0.2.7</version>
		</dependency>

		<dependency>

			<groupId>org.apache.cxf</groupId>

			<artifactId>cxf-rt-frontend-jaxws</artifactId>

			<version>4.0.3</version>

		</dependency>


		<dependency>

			<groupId>org.apache.cxf</groupId>

			<artifactId>cxf-rt-transports-http</artifactId>

			<version>4.0.3</version>

		</dependency>

		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-ws-security</artifactId>
			<version>4.0.3</version>
		</dependency>

		    <!-- @Generated -->
		    <dependency>
		        <groupId>javax.annotation</groupId>
		        <artifactId>javax.annotation-api</artifactId>
		        <version>1.3.2</version>
		    </dependency>
		
		    <!-- @Nullable / @Nonnull -->
		    <dependency>
		        <groupId>com.google.code.findbugs</groupId>
		        <artifactId>jsr305</artifactId>
		        <version>3.0.2</version>
		    </dependency>
		
		    <!-- JAX-RS API -->
		    <dependency>
		        <groupId>javax.ws.rs</groupId>
		        <artifactId>javax.ws.rs-api</artifactId>
		        <version>2.1.1</version>
		    </dependency>
		
		    <!-- RESTEasy client -->
		    <dependency>
		        <groupId>org.jboss.resteasy</groupId>
		        <artifactId>resteasy-client</artifactId>
		        <version>4.7.9.Final</version>
		    </dependency>
		
		    <!-- RESTEasy multipart (MultipartFormDataOutput) -->
		    <dependency>
		        <groupId>org.jboss.resteasy</groupId>
		        <artifactId>resteasy-multipart-provider</artifactId>
		        <version>4.7.9.Final</version>
		    </dependency>

		    <!-- RESTEasy Jackson2: deserializza JSON dal Configuratore -->
		    <dependency>
		        <groupId>org.jboss.resteasy</groupId>
		        <artifactId>resteasy-jackson2-provider</artifactId>
		        <version>4.7.9.Final</version>
		    </dependency>

</dependencies>


	<build>
		<plugins>

			<!-- Apache CXF codegen: genera il client SOAP dal WSDL -->
			<plugin>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-codegen-plugin</artifactId>
				<version>4.0.3</version>
				<executions>
					<execution>
						<id>generate-ws-client</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>wsdl2java</goal>
						</goals>
						<configuration>
							<wsdlOptions>
								<wsdlOption>
									<wsdl>
										${project.basedir}/src/main/resources/wsdl/AURA.WS.AnagrafeFind.wsdl</wsdl>
									<extraargs>
										<!-- Pacchetto Java di destinazione -->
										<extraarg>-p</extraarg>
										<extraarg>
											it.csi.registry.soap.AnagrafeFind</extraarg>
									</extraargs>
								</wsdlOption>
								<wsdlOption>
									<wsdl>
										${project.basedir}/src/main/resources/wsdl/AURA.WS.AnagrafeSanitaria.wsdl</wsdl>
									<extraargs>
										<!-- Pacchetto Java di destinazione -->
										<extraarg>-p</extraarg>
										<extraarg>
											it.csi.registry.soap.AnagrafeSanitaria</extraarg>
									</extraargs>
								</wsdlOption>
							</wsdlOptions>
							<outputDir>
								${project.build.directory}/generated-sources/cxf</outputDir>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- OpenAPI Generator: genera codice Java e documentazione -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi.generator.version}</version>
				<executions>
					<!-- genera Java -->
					<execution>
						<id>generate-openapi</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>
								${project.basedir}/src/main/resources/openapi.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<library>spring-boot</library>
							<output>${project.build.directory}/generated-sources/openapi</output>
							<modelPackage>it.csi.registry.model</modelPackage>
							<apiPackage>it.csi.registry.api</apiPackage>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<skipDefaultInterface>true</skipDefaultInterface>
								<useTags>true</useTags>
								<useJakartaEe>true</useJakartaEe>
							</configOptions>
						</configuration>
					</execution>

					<!-- genera documentazione HTML -->
					<execution>
						<id>generate-docs</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>
								${project.basedir}/src/main/resources/openapi.yaml</inputSpec>
							<generatorName>html2</generatorName>
							<output>
								${project.basedir}/src/main/resources/openapi-docs</output>
						</configuration>
					</execution>


					<execution>
						<id>generate-configuratore-rest-client</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/yaml-servizi-esterni/configuratore.yaml</inputSpec>
							<generatorName>java</generatorName>
							<library>resteasy</library>
							<output>
								${project.build.directory}/generated-sources/openapi-configuratore-client</output>
							<apiPackage>it.csi.registry.client.configuratore.api</apiPackage>
							<modelPackage>
								it.csi.registry.client.configuratore.model</modelPackage>
							<invokerPackage>
								it.csi.registry.client.configuratore.invoker</invokerPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<skipOverwrite>true</skipOverwrite>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- aggiunge le sorgenti generate al compile -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<id>add-generated-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<!-- OPENAPI  -->
								<source>
									${project.build.directory}/generated-sources/openapi/src/main/java</source>
								<!-- CXF  -->
								<source>
									${project.build.directory}/generated-sources/cxf</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>